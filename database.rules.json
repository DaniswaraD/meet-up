{"rules":{"rooms":{"$room":{".read":"auth!=null",".write":"auth!=null && data.child('meta/host').val()===auth.uid",
"meta":{".write":"auth!=null && !data.exists()"},
"players":{"$uid":{".write":"auth!=null && auth.uid===$uid",".validate":"newData.hasChildren(['n','x','z','r'])",
"n":{".validate":"newData.isString() && newData.val().length<=16"},"ch":{".validate":"newData.isString() && newData.val().length<=60"}}}}}}}
